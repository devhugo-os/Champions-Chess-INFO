# Configurações do Servidor
PORT=3000
SESSION_SECRET=champions_chess_info_secret_key_123

# Configurações do Firebase
FIREBASE_PROJECT_ID=champions-chess-info
FIREBASE_DATABASE_URL=https://champions-chess-info-default-rtdb.firebaseio.com

# Caminho para o arquivo JSON de credenciais da conta de serviço do Firebase
# Você pode gerar este arquivo no console do Firebase -> Configurações do Projeto -> Contas de Serviço
FIREBASE_SERVICE_ACCOUNT_JSON=./firebase-service-account.json

# Se preferir passar o JSON completo diretamente como string (útil para produção/deploy)
# FIREBASE_SERVICE_ACCOUNT_RAW_JSON='{"type": "service_account", ...}'
